VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
VITE_SUPABASE_PROJECT_URL=https://ousgmjyajyorywpqbdkf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
VITE_TREASURY_API_BASE_URL=https://treasury-app.coti.io
VITE_TREASURY_TOTALS_PATH=/get-total
# Optional Carbon price reference endpoint:
# Local Vite dev uses /carbon-mcp as a same-origin proxy because Carbon does not answer browser preflight.
# Production stays disabled unless a CORS-enabled proxy is explicitly configured.
# VITE_CARBON_MCP_API_BASE_URL=https://your-carbon-proxy.example
# If the bundled Supabase Edge Function carbon-explore-pair is deployed, this opt-in uses
# VITE_SUPABASE_PROJECT_URL/functions/v1/carbon-explore-pair.
# VITE_ENABLE_DEFAULT_CARBON_PROXY=true
# Optional Treasury history sources:
# VITE_API_BASE_URL=http://localhost:8787
# VITE_SNAPSHOT_URL=https://your-domain.com/snapshots.json
# Optional Treasury onchain source:
# VITE_CONTRACT_ADDRESS=0x25975eda0B0Ef3E5D86787Cb89D0A3468C17Bece
# VITE_COTI_RPC_URL=https://mainnet.coti.io/rpc
# VITE_COTI_EXPLORER_URL=https://mainnet.cotiscan.io
# VITE_COTI_EXPLORER_API_URL=https://mainnet.cotiscan.io/api/v2
# Optional recoverable app-wallet profile registry:
# VITE_CW_PROFILE_REGISTRY_CONTRACT_ADDRESS=0xf37196Fafe760E92d3542D837a1595B2a625F618

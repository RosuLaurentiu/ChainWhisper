# Optional Carbon price reference endpoint:
# Local Vite dev uses /carbon-mcp as a same-origin proxy because Carbon does not answer browser preflight.
# For production, set this to a CORS-enabled Carbon proxy or API endpoint.
# VITE_CARBON_MCP_API_BASE_URL=https://your-carbon-proxy.example
# Optional Treasury history sources:
# VITE_API_BASE_URL=http://localhost:8787
# VITE_SNAPSHOT_URL=https://your-domain.com/snapshots.json
# Optional Treasury onchain source:

# App, API, backend source and tests. Reports and runtime data stay outside the graph.
/*
!/src/
!/scripts/
!/tests/
!/workers/
!/supabase/
!/*.ts
!/*.js

# Generated data, saved runtime state and frozen copies are not code-search input.
# Full mode keeps source tests; these exclusions apply in every mode.
.*
node_modules/
artifacts/
abi/
cache/
coverage/
dist/
build/
builds/
build-*/
build[0-9]*/
*-build/
*-build-*/
generated/
output/
reports/
snapshots/
originals/
reference-history/
archive/
backups/
backup/
tmp/
temp/
test-results/
playwright-report/
local-security/
local-validation/
runtime/
wallets/
wallet-state/
state/
states/
secrets/
credentials/
keystore/
vault/
sessions/
journals/
signer-state/
storage-state/
